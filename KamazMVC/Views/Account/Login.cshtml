@model LoginViewModel

@{
    ViewBag.Title = "Вход в личный кабинет";
}

<div style="margin-left: 50px; margin-top: 50px;">
    <div class="row">
        <div class="col-md-6">
            <section>
                <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly"></div>
                    <h3 class="login-cap">Введите логин (имя пользователя) и пароль для авторизации на сайте KamazMVC</h3>

                    <div class="form-group col-md-6">
                        <div class="login-control">
                            <input asp-for="UserName" placeholder="Логин" class="form-control"/>
                        </div>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-6">
                        <div class="password-control">
                            <input asp-for="Password" placeholder="Пароль" class="form-control"/>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div> <br />

                    <div class="form-group col-md-6">
                        <div class="checkbox">
                            <input asp-for="RememberMe" />
                            <label asp-for="RememberMe"></label>
                        </div>
                    </div> <br />

                    <div class="form-group col-md-6">
                        <button type="submit" class="btn btn-primary" name="mode">Войти</button>
                    </div> 
                    <br />
                    <div class="form-group col-md-6">
                        <a class="btn btn-link" href="/account/register">Создать аккаунт</a>
                    </div>
                </form>
            </section>
        </div>
        <div class="col-md-6 col-md-offset-2">
            <div class="login-img"></div>
        </div>
    </div>
</div>


