@model IEnumerable<User>

<h2>Список пользователей</h2>
<table class="table">
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.UserName</td>
            <td>
                <a class="btn btn-sm btn-primary" asp-action="EditRole" asp-route-id="@user.Id">Права доступа</a>
                <a class="btn btn-sm btn-primary" asp-action="EditUser" asp-route-id="@user.Id">Изменить</a>
            </td>
        </tr>
    }
</table>

<a asp-action="RolesList">Список ролей</a>