@model User

@{
    ViewBag.Title = "Профиль";
}

<div>
    @if (Model != null)
    {
        <dl class="row col-sm-12">
            <dt class="col-sm-2">
                ФИО
            </dt>
            <dd class="col-sm-10">
                @Model.Surname @Model.Name @Model.Patronymic
            </dd>
            <dt class="col-sm-2">
                Логин
            </dt>
            <dd class="col-sm-10">
                @Model.UserName
            </dd>
        </dl>
    }
</div>

<form method="post" asp-controller="Account" asp-action="Logout">
    <input type="submit" value="Выход" />
</form>