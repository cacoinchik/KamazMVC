@model User

@{
    ViewBag.Title = "Профиль";
}
<div style="text-align: center">
    <h2>Добро пожаловать @Model.Name @Model.Patronymic </h2>
</div>

<div style="margin-left: 30px">
    @if (Model != null)
    {
        <dl class="row col-sm-12">
            <dt class="col-sm-2">
                ФИО
            </dt>
            <dd class="col-sm-10">
                @Model.Surname @Model.Name @Model.Patronymic
            </dd>
            <dt class="col-sm-2">
                Логин
            </dt>
            <dd class="col-sm-10">
                @Model.UserName
            </dd>
            @if(Model.Email != null)
            {
                <dt class="col-sm-2">
                    Почта
                </dt>
                <dd class="col-sm-10">
                    @Model.Email
                </dd>
            }
        </dl>
    }
</div>

<a class="btn btn-outline-info" asp-controller="Profile" asp-action="EditProfile" asp-route-id="@Model.Id">Изменить личные данные</a>
<a class="btn btn-outline-info" asp-controller="Profile" asp-action="ChangePassword" asp-route-id="@Model.Id">Сменить пароль</a>

<form method="post" asp-controller="Account" asp-action="Logout">
    <div style="text-align: center">
        <input type="submit" value="Выход" />
    </div>
</form>